          {
            "node": "M2 Miss: ECB Fetch Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ECB Fetch OK?": {
      "main": [
        [
          {
            "node": "Parse ECB XML",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "M2 Miss: ECB Fetch Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse ECB XML": {
      "main": [
        [
          {
            "node": "Extract Currency Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Currency Items": {
      "main": [
        [
          {
            "node": "Upsert Rate in S4HANA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert Rate in S4HANA": {
      "main": [
        [
          {
            "node": "M4 Log: Rate Written",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "error": [
        [
          {
            "node": "M4 Log: Rate Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "M4 Log: Rate Written": {
